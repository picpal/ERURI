# 작성 규칙 (supabase CLI·deno --env-file 모두 이 파일을 읽는다. 파싱 실패 시 CLI 전체가 멈춘다)
# - 값은 한 줄. 여러 줄 값(.p8 등)은 줄바꿈을 \n 으로 이어 큰따옴표로 감싼다: APNS_P8="-----BEGIN PRIVATE KEY-----\nMIG...\n-----END PRIVATE KEY-----"
# - 특수문자(# $ 공백 따옴표 등)가 있는 값은 작은따옴표로 감싼다(# 뒤가 주석으로 잘린다): SUPABASE_DB_PASSWORD='p#ss'
# Supabase (프로젝트 대시보드 → Settings → API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# 봉투 암호화 마스터 키(제품 전용, PoC 키 재사용 금지). M1-①b 가 생성한다
MASTER_KEY=
# 실사용자(첫 Apple 로그인 후 M1-②d 에서 기입). 테스트는 이 사용자의 행을 만들거나 지우지 않는다
ERURI_USER_ID=
# AI (OpenAI: 분류·추출·채팅·임베딩 모두)
OPENAI_API_KEY=
# APNs (Apple Developer → Keys → APNs 키 .p8). Edge 는 supabase secrets 의 APNS_P8, 로컬 테스트·스크립트는 APNS_P8_PATH 를 쓴다
APNS_KEY_ID=
APNS_TEAM_ID=6626BYCJG4
APNS_TOPIC=com.picpal.eruri
# 저장소 루트 기준 경로, 예: supabase/keys/AuthKey_Q8469KDH4D.p8
APNS_P8_PATH=
# Gmail (GCP → APIs & Services → Credentials, Pub/Sub)
GOOGLE_CLIENT_ID=            # iOS 클라이언트 (secret 없음, 앱에서 사용)
GOOGLE_WEB_CLIENT_ID=        # Web 클라이언트 (serverClientID·서버 토큰 교환용)
GOOGLE_CLIENT_SECRET=
PUBSUB_SA_EMAIL=
GMAIL_PUBSUB_TOPIC=
# DB 비밀번호 (supabase link·db push, scripts/sql.ts·vault-setup.ts 용). 특수문자가 있으면 작은따옴표로 감싼다
SUPABASE_DB_PASSWORD=
PUBSUB_PUSH_SA_EMAIL=         # Push 구독 OIDC 서비스 계정 (webhook 검증용)
CLASSIFY_PROVIDER=jev
CLASSIFY_THRESHOLD=0.8
JEV_API_KEY=
SLACK_WEBHOOK_URL=
