# 작성 규칙 (supabase CLI·deno --env-file 모두 이 파일을 읽는다. 파싱 실패 시 CLI 전체가 멈춘다)
# - 값은 한 줄. 여러 줄 값(.p8 등)은 줄바꿈을 \n 으로 이어 큰따옴표로 감싼다: APNS_P8="-----BEGIN PRIVATE KEY-----\nMIG...\n-----END PRIVATE KEY-----"
# - 특수문자(# $ 공백 따옴표 등)가 있는 값은 작은따옴표로 감싼다(# 뒤가 주석으로 잘린다): SUPABASE_DB_PASSWORD='p#ss'
# Supabase (프로젝트 대시보드 → Settings → API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# 봉투 암호화 마스터 키 (PoC 전용). openssl rand -base64 32
MASTER_KEY=
# PoC 사용자 (Task 8 Step 에서 생성 후 UUID 기입). 비밀번호: openssl rand -base64 18
POC_USER_ID=
POC_USER_PASSWORD=
# AI (OpenAI: 분류·추출·채팅·임베딩 모두)
OPENAI_API_KEY=
# APNs (Apple Developer → Keys → APNs 키 .p8). APNS_P8 은 파일 내용을 \n 으로 이어 한 줄로
APNS_KEY_ID=
APNS_TEAM_ID=6626BYCJG4
APNS_P8=
APNS_TOPIC=com.picpal.assistant.poc
# Gmail (GCP → APIs & Services → Credentials, Pub/Sub)
GOOGLE_CLIENT_ID=            # iOS 클라이언트 (secret 없음, 앱에서 사용)
GOOGLE_WEB_CLIENT_ID=        # Web 클라이언트 (serverClientID·서버 토큰 교환용)
GOOGLE_CLIENT_SECRET=
PUBSUB_SA_EMAIL=
GMAIL_PUBSUB_TOPIC=
# DB 비밀번호 (supabase link·db push, scripts/sql.ts·vault-setup.ts 용). 특수문자가 있으면 작은따옴표로 감싼다
SUPABASE_DB_PASSWORD=
